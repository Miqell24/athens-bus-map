{
  "name": "athens-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Athens public transport (OASA) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all --tram M1,M2,M3,T6,T7",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8125"
  }
}
